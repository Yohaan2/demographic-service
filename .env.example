# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - DEMOGRAPHIC SERVICE
# ==============================================================================
# Copia este archivo a .env y ajusta los valores según tu entorno de despliegue.

# --- Configuración del Servidor ---
HOST=0.0.0.0
PORT=8000
# En Docker se ignora: cada contenedor ejecuta UN solo proceso Uvicorn (ver BACKEND_REPLICAS).
WORKERS=1

# --- Escalado (docker-compose) ---
# Número de réplicas del backend (1 proceso cada una). Nginx reparte por hash de X-Camera-Id,
# así que cada cámara va siempre a la misma réplica (el tracker vive en memoria por proceso).
BACKEND_REPLICAS=8

# --- Modelos y Estrategias de IA ---
# insightface (ONNX puro, el que lleva la imagen Docker) | mivolo (requiere PyTorch)
MODEL_TYPE=insightface
DETECTOR=scrfd

# Modo estricto: si un modelo falta o no carga, el contenedor NO arranca (no queda healthy),
# y si la inferencia falla el endpoint responde 500. Nunca se devuelven datos inventados
# (sin Haar Cascade ni fallback SHA-256). Ponerlo a false SOLO en desarrollo.
STRICT_MODELS=true

# --- Rutas de los Modelos ONNX ---
# Los archivos deben estar en models/weights/ en el host (se montan en solo lectura)
DETECTOR_MODEL_PATH=models/weights/scrfd_2.5g_bnkps.onnx
INSIGHTFACE_MODEL_PATH=models/weights/genderage.onnx
# Solo se usa con MODEL_TYPE=mivolo
# AGE_GENDER_MODEL_PATH=models/weights/mivolo_v2.onnx

# --- Hilos y concurrencia de inferencia (por réplica) ---
# Hilos intra-op de cada sesión ONNX Runtime.
ORT_INTRA_OP_THREADS=2
# Frames procesados a la vez por réplica. Hilos de CPU por réplica ≈ ORT_INTRA_OP_THREADS × INFERENCE_CONCURRENCY;
# total ≈ eso × BACKEND_REPLICAS (no debería superar los núcleos físicos asignados al servicio).
INFERENCE_CONCURRENCY=2

# --- Configuración de Tracking ---
MAX_TRACKERS=500
TRACKER_TTL=300

# --- Configuración de Agregación Temporal ---
AGGREGATION_WINDOW=10

# --- Control de Carga y Backpressure ---
# Peticiones simultáneas (en cola + en proceso) por réplica antes de responder 429.
MAX_PENDING_REQUESTS=64

# --- Configuración de Recorte Facial ---
CROP_SIZE=224

# --- Trazas OpenTelemetry ---
# true/1/yes: no se crea el exporter OTLP ni se instrumenta FastAPI.
# Para activarlas: OTEL_SDK_DISABLED=false y OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4317
OTEL_SDK_DISABLED=true

# --- Nivel de Logging ---
LOG_LEVEL=INFO
